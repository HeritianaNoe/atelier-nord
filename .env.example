# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atelier_nord?schema=public"

# Admin login (email must belong to a user with role ADMIN; the seed creates admin@atelier-nord.com)
ADMIN_PASSWORD="change-me-please"

# Random string (32+ chars) used to sign the admin session cookie. Generate: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"
